# Database URL (MySQL / Laragon / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/dlh_db"

# Secret Key untuk pembuatan JWT token autentikasi sesi
JWT_SECRET="dlh-samarinda-jwt-secret-key-2024"

# Node Environment
NODE_ENV="development"
